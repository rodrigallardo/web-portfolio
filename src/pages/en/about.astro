---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n';
import { WHATSAPP_PHONE_NUMBER } from '../../config';

const t = useTranslations('en');
const whatsappUrl = `https://wa.me/${WHATSAPP_PHONE_NUMBER}`;
---

<Layout
  title={t('nav.about')}
  description="Rodrigo Gallardo, from Montevideo, Uruguay. Software and AI engineer passionate about art and oil painting."
>
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="text-center">
      <h1 class="text-5xl font-bold text-gray-900 mb-12">{t('nav.about')}</h1>
    </div>

    <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-start">
      <div class="flex-1 space-y-6 text-gray-700 md:order-1">
        <p class="text-2xl leading-relaxed">
          I'm Rodrigo, welcome to my painting catalog.
        </p>

        <div class="flex-shrink-0 mx-auto md:hidden">
          <img
            src="/images/me.png"
            alt="Rodrigo Gallardo"
            class="rounded-lg w-80 h-80 object-cover shadow-lg"
          />
        </div>

        <p class="text-lg leading-relaxed">
          I'm a painter from Montevideo, Uruguay, a software and AI engineer by profession. Creating has always been my passion, and in painting and art I've found a medium to better explore my desire to create, play, make mistakes, and try again.
        </p>
        <p class="text-lg leading-relaxed">
          I'm fascinated by the interchange of colors, light and dark, the beauty and joy that a painting can convey. I enjoy the pleasure of appreciating a well-placed brushstroke, of seeing the world through someone else's eyes, and hopefully sharing with others what my eyes can see.
        </p>
        <p class="text-lg leading-relaxed mt-8">
          If you're interested in any artwork, you can contact me via <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-gray-900 font-medium hover:text-gray-700 underline">WhatsApp</a> or email at <a href="mailto:rodrigo.gallardo.negrin@gmail.com" class="text-gray-900 font-medium hover:text-gray-700 underline">rodrigo.gallardo.negrin@gmail.com</a>.
        </p>
      </div>

      <div class="flex-shrink-0 mx-auto md:mx-0 hidden md:block md:order-2">
        <img
          src="/images/me.png"
          alt="Rodrigo Gallardo"
          class="rounded-lg w-96 h-96 object-cover shadow-lg"
        />
      </div>
    </div>
  </div>
</Layout>
